    "@hono/zod-openapi": "^0.18.4",
    "@neondatabase/serverless": "^1.1.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.5",
    "ioredis": "^5.6.1",
    "jose": "^6.2.10",
    "pg": "^8.13.3",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.30.5",
