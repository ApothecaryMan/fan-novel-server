PORT=4000
DATABASE_URL=postgres://novel_admin:novel_secure_password_2026@localhost:5432/web_novel_db
JWT_SECRET=change-me-in-production
# LAN-first default: auto-provision users by external_id, no token needed.
# Set SYNC_OPEN=false to require a Bearer JWT (matches mobile userAccount.token).
SYNC_OPEN=true
# Admin bootstrap: comma-separated emails auto-promoted to admin on Google login
ADMIN_EMAILS=mohamed1232003@gmail.com
# Google OAuth client IDs (must match Fan Novel app.json extra.googleAuth; used for idToken aud check)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=
# Comma-separated allowed origins, or * for dev
CORS_ORIGIN=*
NODE_ENV=development
# Optional Redis cache (Upstash free tier works)
REDIS_URL=
# Upload limit in MB (2MB covers stay sharp and keep Neon usage tiny)
UPLOAD_MAX_MB=2
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_PUBLIC_URL=
